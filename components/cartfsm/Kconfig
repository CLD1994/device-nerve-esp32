menu "cartfsm - 模式机"

config CARTFSM_TEST_HOOKS
    bool "编入流程测试注入钩子"
    default n
    help
        编入 cartfsm_test_* 注入钩子（命令直注、编码器失联注入、
        丢步偏差注入、标定状态复位）。仅供独立测试工程（test/，
        经其 sdkconfig 默认开启）使用，流程测试用例
        （test_cartfsm_flow.c）依赖这些钩子。

        与历史 FLOW_TEST 选项不同：本项不自动运行任何测试，仅暴露
        注入接口。正式固件保持关闭。

config CARTFSM_STEP_LOSS_DIAGNOSTICS
    bool "启用 STEP_LOSS 故障快照（调试诊断）"
    default n
    help
        开启后记录失步触发时的位置、时间和编码器元数据，可在停车后
        用 STEPLOSS? 导出。关闭时不分配快照存储、不执行快照专属采集，
        查询返回 STEPLOSS_DISABLED。默认保持失步检测和故障停车；
        下方观察模式需要另行显式选择。

config CARTFSM_STEP_LOSS_OBSERVE_ONLY
    bool "仅观察 STEP_LOSS，不因跟随误差停车（临时现场诊断）"
    depends on CARTFSM_STEP_LOSS_DIAGNOSTICS
    default n
    help
        开启后 STEP_LOSS 判据只锁存本次上电的第一次命中及诊断缓冲，
        不进入 FAULT、不改变目标速度或加速度、不禁用驱动。RESET和
        新运行均不覆盖首份证据；停车后可用 STEPLOSS?/STEPTRACE? 读取。
        READY 中仍拒绝诊断查询。供电、编码器故障、软限位和命令看门狗
        保持原行为。本选项暂时移除了跟随误差停车能力，只用于有人在场、
        可独立断电的现场排查；不是正式运行或安全验收配置。

config CARTFSM_FOLLOWING_ERROR_WINDOW
    bool "启用实验性窗口跟随误差判定"
    default n
    help
        允许有限、稳定的累计偏差；连续窗口向外增长或达到独立硬限时停车。
        不重置STEP累计位置。参数是现场联调起点，不是经过验证的安全值。

if CARTFSM_FOLLOWING_ERROR_WINDOW
config CARTFSM_FOLLOWING_ERROR_HARD_UM
    int "累计误差立即停车门限（um）"
    range 1000 50000
    default 6000
config CARTFSM_FOLLOWING_ERROR_WINDOW_MS
    int "增长观察窗口（ms）"
    range 5 200
    default 50
config CARTFSM_FOLLOWING_ERROR_GROWTH_UM
    int "每窗口最小向外增长（um）"
    range 100 10000
    default 1000
config CARTFSM_FOLLOWING_ERROR_WINDOWS
    int "连续增长窗口数"
    range 2 10
    default 2
endif

endmenu
